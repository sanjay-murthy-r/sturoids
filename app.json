{
  "expo": {
    "name": "Sturoids",
    "slug": "all-in-one-student-app",
    "version": "1.7.0",
    "scheme": "sturoids",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#30302E",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#30302E"
    },
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#30302E",
      "barStyle": "light"
    },
    "android": {
      "package": "com.sanjay.studenthub",
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#262624"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sturoids attaches your photos and videos inside notes.",
          "cameraPermission": "Sturoids takes photos to attach inside your notes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sturoids listens while you dictate, to turn your speech into note text.",
          "speechRecognitionPermission": "Sturoids turns your speech into note text."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sturoids uses Face ID to open your journal and Notes, when you allow it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#30302E"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "./plugins/withAsyncStorageSize.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c5fbee9-3b22-4f4a-a856-e55295966de1"
      }
    }
  }
}
