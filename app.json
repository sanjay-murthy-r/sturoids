{
  "expo": {
    "name": "Sturoids",
    "slug": "all-in-one-student-app",
    "version": "2.0.0",
    "scheme": "sturoids",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#30302E",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#30302E"
    },
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#30302E",
      "barStyle": "light"
    },
    "android": {
      "package": "com.sanjay.studenthub",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A9ADB5"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sturoids attaches your photos and videos inside notes.",
          "cameraPermission": "Sturoids takes photos to attach inside your notes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sturoids listens while you dictate, to turn your speech into note text.",
          "speechRecognitionPermission": "Sturoids turns your speech into note text."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sturoids uses Face ID to open your journal and Notes, when you allow it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#30302E"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav"
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "application/pdf"
          ]
        }
      ],
      "./plugins/withAsyncStorageSize.js",
      "./plugins/withAppShortcuts.js",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter-tight/400Regular/InterTight_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter-tight/500Medium/InterTight_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter-tight/600SemiBold/InterTight_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter-tight/300Light/InterTight_300Light.ttf",
            "./node_modules/@expo-google-fonts/schibsted-grotesk/400Regular/SchibstedGrotesk_400Regular.ttf",
            "./node_modules/@expo-google-fonts/schibsted-grotesk/500Medium/SchibstedGrotesk_500Medium.ttf",
            "./node_modules/@expo-google-fonts/source-serif-4/500Medium/SourceSerif4_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "DayRing",
              "label": "Day ring",
              "description": "ToDos done and focus minutes, as two rings",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-previews/dayring.png"
            },
            {
              "name": "AtAGlance",
              "label": "At a glance",
              "description": "The next block, three open ToDos and your habits",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-previews/ataglance.png"
            },
            {
              "name": "Agenda",
              "label": "Agenda",
              "description": "Today as a timeline, with a line for now",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-previews/agenda.png"
            },
            {
              "name": "Clock",
              "label": "Clock",
              "description": "The time, the date, what is next and the day so far",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-previews/clock.png"
            },
            {
