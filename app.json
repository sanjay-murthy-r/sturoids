      ],
      "./plugins/withWidgetPreviewsNodpi.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c5fbee9-3b22-4f4a-a856-e55295966de1"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Sturoids",
      "backgroundColor": "#262624",
      "themeColor": "#262624"
    }
  }
}
