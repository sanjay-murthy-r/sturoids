{
  "expo": {
    "name": "Sturoids",
    "slug": "all-in-one-student-app",
    "version": "1.4.1",
    "scheme": "sturoids",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#30302E",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#30302E"
    },
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#30302E",
      "barStyle": "light"
    },
    "android": {
      "package": "com.sanjay.studenthub",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#262624"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sturoids attaches your photos and videos inside notes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sturoids uses the microphone for voice notes.",
          "speechRecognitionPermission": "Sturoids converts your speech to note text on-device."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sturoids uses Face ID to unlock your journal and locked notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#30302E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c5fbee9-3b22-4f4a-a856-e55295966de1"
      }
    }
  }
}
