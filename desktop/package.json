{
  "name": "sturoids-desktop",
  "productName": "Sturoids",
  "version": "3.5.0",
  "description": "Sturoids for Windows",
  "author": "Sanjay Murthy",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.sanjay.sturoids",
    "productName": "Sturoids",
    "artifactName": "Sturoids-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "icon.png", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sturoids"
    }
  }
}
